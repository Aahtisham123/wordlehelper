{
  "name": "wordlehelper",
  "version": "1.0.0",
  "private": true,
  "description": "Static site generator for wordlehelp.co — Wordle Helper, solvers, word lists, daily hints and guides.",
  "type": "module",
  "scripts": {
    "build": "node src/build.mjs",
    "serve": "node scripts/serve.mjs",
    "dev": "node src/build.mjs && node scripts/serve.mjs",
    "test": "node --test test/*.test.mjs",
    "wordlists": "node scripts/build-wordlists.mjs",
    "add-answer": "node scripts/add-answer.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "wordlist-english": "1.2.1"
  }
}
